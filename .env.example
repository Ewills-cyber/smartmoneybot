# Copy this file to .env and fill in the values you have.
# Never commit .env. The bot ignores blank, "-", and "unused".

# From @BotFather. Required for Telegram alerts and commands.
TELEGRAM_BOT_TOKEN=

# Your chat id, or several separated by commas.
# Leave this blank, start the bot, send /start, and copy the id from the log.
TELEGRAM_CHAT_ID=

# Optional. Holder count and top-holder share. https://birdeye.so
BIRDEYE_API_KEY=

# Optional. Uses Helius mainnet RPC when SOLANA_RPC is unset. https://helius.dev
HELIUS_API_KEY=

# Optional. Overrides the public Solana RPC and the Helius URL above.
# SOLANA_RPC=https://api.mainnet-beta.solana.com

# Optional. Public wallet addresses, separated by commas or spaces.
# When 2 or more buy the same mint inside CLUSTER_WINDOW_MINUTES, the alert
# is marked as smart money. Discovery alerts still run without this list.
SMART_WALLETS=

# Set to 1 to alert only when a smart-money cluster is present.
REQUIRE_CLUSTER=0

# Gate. These match the original bot.
MAX_ENTRY_MCAP=250000
MIN_LIQUIDITY_USD=12000
MIN_VOLUME_H1=8000
MAX_PAIR_AGE_HOURS=72
MIN_HOLDERS=150
MAX_TOP_HOLDER_PCT=15

# Paper position rules.
TRADE_SIZE_SOL=0.05
MAX_OPEN_POSITIONS=4
MAX_DAILY_LOSS_SOL=0.3
TAKE_PROFIT_MULTIPLE=2.5
STOP_LOSS_MULTIPLE=0.65
TIME_STOP_MINUTES=180
MIN_CLUSTER_WALLETS=2
CLUSTER_WINDOW_MINUTES=15

# off | paper | live. paper is the default and does not send swaps.
# live spends SOL. Do not set live on Render's free plan: its disk is wiped
# on restart and the bot would forget which mints it already bought.
TRADE_MODE=paper

# Required only for TRADE_MODE=live. From https://gmgn.ai/ai
# The private key is the PEM that matches the public key uploaded with the API key.
# One line is fine if newlines are written as \n.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=
GMGN_WALLET=

# Optional GMGN knobs.
# GMGN_SLIPPAGE=30
# GMGN_ANTI_MEV=1
# GMGN_PRIORITY_FEE=0.00001
# GMGN_TIP_FEE=0.00001
# GMGN_ALLOW_EPHEMERAL_DB=0

# Scanner.
POLL_SECONDS=45
DISCOVERY_LIMIT=30
LOG_LEVEL=INFO
ENABLE_PROFILE_STREAM=1

# Set by Render. Leave blank locally.
# KEEP_AWAKE=1
# KEEP_AWAKE_URL=https://your-service.onrender.com
# SMARTMONEY_DB=/tmp/smartmoney.db
# PORT=10000
